    <color name="ink_secondary">#6B6B70</color>
    <color name="ink_tertiary">#A3A3A8</color>
    <color name="ink_disabled">#C7C7CC</color>

    <color name="line">#EEEEEE</color>
    <color name="line_strong">#DCDCDF</color>
    <color name="fill">#F6F6F7</color>
    <color name="fill_pressed">#EDEDEF</color>

    <color name="red">#E5383B</color>
    <color name="red_soft">#FDEEEE</color>
    <color name="green">#1E9E5A</color>
    <color name="green_soft">#EAF7F0</color>
    <color name="amber">#C27C0E</color>
    <color name="amber_soft">#FDF5E6</color>

