<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ============ Typography ============ -->
    <style name="Text" parent="">
        <item name="android:textColor">@color/ink</item>
        <item name="android:includeFontPadding">true</item>
    </style>

    <!-- Tiêu đề lớn của màn hình -->
    <style name="Text.Display">
        <item name="android:textSize">28sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <style name="Text.Headline">
        <item name="android:textSize">22sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <style name="Text.Title">
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Text.Body">
        <item name="android:textSize">15sp</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>

    <style name="Text.Secondary">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/ink_secondary</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>

    <style name="Text.Caption">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/ink_tertiary</item>
    </style>

    <!-- Nhãn nhỏ phía trên mỗi nhóm nội dung -->
    <style name="Text.Overline">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/ink_tertiary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.04</item>
    </style>

    <!-- Tag nhỏ dạng viên thuốc -->
    <style name="Text.Tag">
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/ink_secondary</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:paddingTop">3dp</item>
        <item name="android:paddingBottom">3dp</item>
        <item name="android:background">@drawable/bg_pill</item>
        <item name="android:backgroundTint">@color/fill</item>
    </style>

    <!-- Giữ tên style cũ để tương thích -->
    <style name="Text.Small" parent="Text.Caption" />
    <style name="Text.Label" parent="Text.Overline" />
    <style name="Text.Badge" parent="Text.Tag" />

    <!-- Dòng thông tin có icon nhỏ bên trái -->
    <style name="Text.IconRow" parent="Text.Secondary">
        <item name="android:drawablePadding">10dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="drawableTint">@color/ink_secondary</item>
    </style>

    <!-- ============ Bottom Navigation ============ -->
    <style name="BottomNav.Minimal" parent="Widget.Material3.BottomNavigationView">
        <item name="android:background">@color/white</item>
        <item name="elevation">0dp</item>
        <item name="itemActiveIndicatorStyle">@null</item>
        <item name="itemIconTint">@color/sel_bottom_nav</item>
        <item name="itemTextColor">@color/sel_bottom_nav</item>
        <item name="itemRippleColor">@color/fill</item>
        <item name="labelVisibilityMode">labeled</item>
    </style>

    <!-- ============ Toolbar ============ -->
    <style name="Toolbar.Minimal" parent="Widget.Material3.Toolbar">
        <item name="titleTextAppearance">@style/TextAppearance.App.ToolbarTitle</item>
        <item name="subtitleTextAppearance">@style/TextAppearance.App.ToolbarSubtitle</item>
        <item name="navigationIconTint">@color/ink</item>
        <item name="android:background">@color/white</item>
        <item name="contentInsetStartWithNavigation">4dp</item>
    </style>

    <style name="TextAppearance.App.ToolbarTitle" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">17sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/ink</item>
    </style>

    <style name="TextAppearance.App.ToolbarSubtitle" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textColor">@color/ink_tertiary</item>
    </style>

    <!-- ============ Card ============ -->
    <style name="Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/white</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/line</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- ============ Buttons ============ -->
    <style name="Button.Primary" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/sel_btn_primary_bg</item>
        <item name="android:textColor">@color/sel_btn_primary_text</item>
        <item name="iconTint">@color/sel_btn_primary_text</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <!-- Nút đỏ: chỉ dùng cho hành động SOS -->
    <style name="Button.Sos" parent="Button.Primary">
        <item name="backgroundTint">@color/sel_btn_danger_bg</item>
    </style>

    <!-- Nút viền mảnh -->
    <style name="Button.Secondary" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textColor">@color/sel_btn_text</item>
        <item name="iconTint">@color/sel_btn_text</item>
        <item name="strokeColor">@color/line_strong</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="Button.Outlined" parent="Button.Secondary" />

    <!-- Nút chữ -->
    <style name="Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">@color/sel_btn_text</item>
        <item name="iconTint">@color/sel_btn_text</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="Button.Text.Danger">
        <item name="android:textColor">@color/sel_btn_text_danger</item>
        <item name="iconTint">@color/sel_btn_text_danger</item>
    </style>

    <!-- Nút nhỏ trong danh sách -->
    <style name="Button.Small" parent="Button.Primary">
        <item name="android:minHeight">36dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:textSize">13sp</item>
        <item name="cornerRadius">10dp</item>
    </style>

    <!-- Nút icon trong suốt -->
    <style name="Button.Icon" parent="Widget.Material3.Button.IconButton">
        <item name="iconTint">@color/ink</item>
        <item name="iconSize">22dp</item>
    </style>

    <!-- Nút điều khiển nổi trên bản đồ -->
    <style name="Button.MapControl" parent="Widget.Material3.Button.IconButton.Outlined">
        <item name="backgroundTint">@color/white</item>
        <item name="iconTint">@color/ink</item>
        <item name="iconSize">20dp</item>
        <item name="strokeColor">@color/line_strong</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- Nút phân đoạn (chọn vai trò) -->
    <style name="Button.Segment" parent="Widget.Material3.Button.OutlinedButton">
        <item name="backgroundTint">@color/sel_chip_bg</item>
        <item name="android:textColor">@color/sel_chip_text</item>
        <item name="strokeColor">@color/line_strong</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:minHeight">46dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <!-- ============ Chips ============ -->
    <style name="Chip.Minimal" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/sel_chip_bg</item>
        <item name="android:textColor">@color/sel_chip_text</item>
        <item name="chipStrokeColor">@color/sel_chip_stroke</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="checkedIconVisible">false</item>
        <item name="chipIconVisible">false</item>
        <item name="chipMinHeight">34dp</item>
        <item name="android:minHeight">34dp</item>
        <item name="ensureMinTouchTargetSize">false</item>
        <item name="android:textSize">13sp</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.App.Pill</item>
    </style>

    <!-- Chip chèn nhanh (không giữ trạng thái chọn) -->
    <style name="Chip.Suggestion" parent="Widget.Material3.Chip.Assist">
        <item name="chipBackgroundColor">@color/fill</item>
        <item name="android:textColor">@color/ink_secondary</item>
        <item name="chipStrokeWidth">0dp</item>
        <item name="chipMinHeight">32dp</item>
        <item name="android:minHeight">32dp</item>
        <item name="ensureMinTouchTargetSize">false</item>
        <item name="android:textSize">12.5sp</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.App.Pill</item>
    </style>

    <!-- ============ Inputs ============ -->
    <style name="Input" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="boxStrokeColor">@color/sel_input_stroke</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">1.5dp</item>
        <item name="hintTextColor">@color/ink</item>
        <item name="android:textColorHint">@color/ink_tertiary</item>
        <item name="boxStrokeErrorColor">@color/red</item>
        <item name="errorTextColor">@color/red</item>
    </style>

    <!-- ============ Divider ============ -->
    <style name="Divider" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:background">@color/line</item>
    </style>
</resources>
