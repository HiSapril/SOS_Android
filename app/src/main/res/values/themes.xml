<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme: Minimal – nền trắng, chữ đen, nhấn đỏ cho SOS. -->
    <style name="Base.Theme.JavaFinal" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/ink</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/fill</item>
        <item name="colorOnPrimaryContainer">@color/ink</item>
        <item name="colorSecondary">@color/ink</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSecondaryContainer">@color/fill</item>
        <item name="colorOnSecondaryContainer">@color/ink</item>
        <item name="colorError">@color/red</item>

        <item name="colorSurface">@color/white</item>
        <item name="colorOnSurface">@color/ink</item>
        <item name="colorOnSurfaceVariant">@color/ink_secondary</item>
        <item name="colorSurfaceContainerLowest">@color/white</item>
        <item name="colorSurfaceContainerLow">@color/white</item>
        <item name="colorSurfaceContainer">@color/white</item>
        <item name="colorSurfaceContainerHigh">@color/white</item>
        <item name="colorSurfaceContainerHighest">@color/fill</item>
        <item name="colorOutline">@color/line_strong</item>
        <item name="colorOutlineVariant">@color/line</item>

        <item name="colorSurfaceInverse">@color/ink</item>
        <item name="colorOnSurfaceInverse">@color/white</item>
        <item name="colorPrimaryInverse">@color/white</item>

        <item name="android:colorBackground">@color/white</item>
        <item name="android:windowBackground">@color/white</item>
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="android:textColorSecondary">@color/ink_secondary</item>
        <item name="android:textColorHint">@color/ink_tertiary</item>

        <!-- Status bar / navigation bar trong suốt, icon tối (edge-to-edge xử lý trong Activity) -->
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>

        <!-- Widget mặc định -->
        <item name="materialButtonStyle">@style/Button.Primary</item>
        <item name="textInputStyle">@style/Input</item>
        <item name="toolbarStyle">@style/Toolbar.Minimal</item>
        <item name="materialCardViewStyle">@style/Card</item>
        <item name="checkboxStyle">@style/Widget.Material3.CompoundButton.CheckBox</item>

        <!-- Hộp thoại: bottom sheet bo góc + snackbar tối giản thay cho AlertDialog/Toast -->
        <item name="bottomSheetDialogTheme">@style/ThemeOverlay.App.BottomSheetDialog</item>
        <item name="snackbarStyle">@style/Widget.App.Snackbar</item>
        <item name="snackbarTextViewStyle">@style/Widget.App.Snackbar.Text</item>
        <item name="snackbarButtonStyle">@style/Widget.App.Snackbar.Button</item>
    </style>

    <style name="Theme.JavaFinal" parent="Base.Theme.JavaFinal" />

    <!-- Splash: nền trắng toàn màn hình -->
    <style name="Theme.JavaFinal.Splash" parent="Base.Theme.JavaFinal">
        <item name="android:windowBackground">@color/white</item>
    </style>

    <!-- Bottom sheet -->
    <style name="ThemeOverlay.App.BottomSheetDialog" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.App.BottomSheet</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/white</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
    </style>

    <style name="Widget.App.BottomSheet" parent="Widget.Material3.BottomSheet">
        <item name="backgroundTint">@color/white</item>
        <item name="shapeAppearance">@style/ShapeAppearance.App.Sheet</item>
    </style>

    <style name="ShapeAppearance.App.Sheet" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">24dp</item>
        <item name="cornerSizeTopRight">24dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <!-- Snackbar -->
    <style name="Widget.App.Snackbar" parent="Widget.Material3.Snackbar">
        <item name="backgroundTint">@color/ink</item>
        <item name="shapeAppearance">@style/ShapeAppearance.App.Rounded12</item>
        <item name="android:layout_margin">16dp</item>
    </style>

    <style name="Widget.App.Snackbar.Text" parent="Widget.Material3.Snackbar.TextView">
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="Widget.App.Snackbar.Button" parent="Widget.Material3.Button.TextButton.Snackbar">
        <item name="android:textColor">@color/white</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="ShapeAppearance.App.Rounded12" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>

    <style name="ShapeAppearance.App.Pill" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>
</resources>
