# Mẫu cấu hình môi trường cho Backend
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=sos_db
PGUSER=postgres
PGPASSWORD=postgres

JWT_SECRET=replace_with_a_secure_random_key
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Token Telegram Bot từ @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

DEV_MOCK_OTP=true
OTP_EXPIRE_MINUTES=5
OTP_MAX_ATTEMPTS=5
SOS_TIMEOUT_HOURS=2
